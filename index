h1.addEventListener("pointerleave",()=>sp.forEach(s=>s.style.fontVariationSettings='"wdth" 62'));
h1.style.touchAction="pan-y";
function status(){try{const n=new Date(new Date().toLocaleString("en-US",{timeZone:"Asia/Jakarta"})),h=n.getHours(),o=h>=8,e=document.getElementById("open");e.classList.toggle("y",o);e.querySelector("span").textContent=o?"Buka sekarang, sampai 00.00 WIB":"Tutup sekarang, buka lagi 08.00 WIB"}catch(e){}}
rv(document.querySelectorAll(".hero .wrap>*:not(.hrow)"),.14,6);
rv(document.querySelectorAll(".hrow .htxt>*"),.14,6);rv(document.querySelectorAll(".hero-photo"),0);
rv(document.querySelectorAll("section h2,section .lead"),0);
rv(document.querySelectorAll(".wall .photo"),.14,3);rv(document.querySelectorAll(".rev"),.12);
rv(document.querySelectorAll("#review .pills,.info>div,footer .wrap"),.14,3);
 status();setInterval(status,60000);
